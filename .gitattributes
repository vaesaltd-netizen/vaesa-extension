# Script shell cho macOS — BẮT BUỘC xuống dòng LF, nếu CRLF sẽ lỗi "bad interpreter".
update.command text eol=lf
*.command text eol=lf
*.sh text eol=lf

# Script batch cho Windows — BẮT BUỘC xuống dòng CRLF, nếu LF cmd.exe đọc sai lệnh.
# Để -text (coi như nhị phân) → git KHÔNG đổi xuống dòng, file zip tải về giữ y nguyên CRLF.
update.bat -text
*.bat -text
